# CVV of the saved card picked in config.yaml (payment.card_last4).
# Lives only in this file on your PC (gitignored), never in config or code.
FK_CARD_CVV=

# Only if payment.use_new_card: true (not recommended; save the card on Flipkart instead)
FK_CARD_NUMBER=
FK_CARD_EXPIRY=   # MM/YY
FK_CARD_NAME=

# Shared secret for the OTP webhook (README: "Hands-free OTP")
OTP_WEBHOOK_TOKEN=change-me
