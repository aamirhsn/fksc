# Telegram API credentials from https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# CVV of the saved card picked in config.yaml (payment.card_last4).
# Kept in .env (gitignored), never in config or code.
FK_CARD_CVV=

# Only needed if you set payment.use_new_card: true (not recommended; prefer a saved card on Flipkart)
FK_CARD_NUMBER=
FK_CARD_EXPIRY=   # MM/YY
FK_CARD_NAME=

# Shared secret for the OTP webhook (see README "Hands-free OTP")
OTP_WEBHOOK_TOKEN=change-me
